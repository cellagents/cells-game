{
  "name": "agar.io-clone",
  "version": "1.0.0",
  "description": "A simple Agar.io clone",
  "main": "server/server.js",
  "scripts": {
    "clean": "rm -rf bin",
    "build": "npm run clean && node scripts/build.mjs && webpack --mode production",
    "build:dev": "npm run clean && node scripts/build.mjs && webpack --mode development",
    "start": "npm run build && node bin/server/server.js",
    "watch": "npm run build:dev && node --watch --watch-path=src bin/server/server.js",
    "test": "mocha test/**/*.js",
    "lint": "eslint \"src/**/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/owenashurst/agar.io-clone.git"
  },
  "author": "Huy Tran",
  "maintainers": [
    {
      "name": "Owen Ashurst"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
